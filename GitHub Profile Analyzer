<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>GitHub Profile Analyzer</title>

<style>
body {
    font-family: Arial, sans-serif;
    background: #f4f6f9;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 100vh;
}

.container {
    background: white;
    padding: 30px;
    border-radius: 12px;
    width: 400px;
    box-shadow: 0 4px 10px rgba(0,0,0,0.15);
    text-align: center;
}

h1 {
    color: #2c3e6b;
}

input {
    width: 80%;
    padding: 10px;
    border: 1px solid #ccc;
    border-radius: 5px;
    margin-bottom: 10px;
}

button {
    background: #2c3e6b;
    color: white;
    border: none;
    padding: 10px 18px;
    border-radius: 5px;
    cursor: pointer;
}

button:hover {
    background: #1c2b4a;
}

#result {
    margin-top: 20px;
    text-align: left;
}

.profile-img {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    display: block;
    margin: 10px auto;
}

.info {
    background: #f4f6f9;
    padding: 10px;
    margin: 8px 0;
    border-radius: 5px;
}

.error {
    color: red;
    font-weight: bold;
}
</style>
</head>

<body>

<div class="container">

    <h1>GitHub Profile Analyzer</h1>

    <input
        type="text"
        id="username"
        placeholder="Enter GitHub username"
    />

    <br>

    <button onclick="analyzeProfile()">
        Analyze Profile
    </button>

    <div id="result"></div>

</div>

<script>

async function analyzeProfile() {

    const username =
        document.getElementById("username").value.trim();

    const result =
        document.getElementById("result");

    if (!username) {
        result.innerHTML =
            `<p class="error">Please enter a GitHub username.</p>`;
        return;
    }

    result.innerHTML = `<p>Loading profile...</p>`;

    try {

        // GitHub API call
        const response = await fetch(
            `https://api.github.com/users/${encodeURIComponent(username)}`
        );

        // Check API response
        if (!response.ok) {
            throw new Error(
                `User not found! Status: ${response.status}`
            );
        }

        // Convert JSON response
        const user = await response.json();

        // Display profile information
        result.innerHTML = `

            <img
                src="${user.avatar_url}"
                class="profile-img"
            >

            <h2>${user.name || user.login}</h2>

            <p>
                <strong>Username:</strong>
                ${user.login}
            </p>

            <p>
                <strong>Bio:</strong>
                ${user.bio || "No bio available"}
            </p>

            <div class="info">
                <strong>Followers:</strong>
                ${user.followers}
            </div>

            <div class="info">
                <strong>Following:</strong>
                ${user.following}
            </div>

            <div class="info">
                <strong>Public Repositories:</strong>
                ${user.public_repos}
            </div>

            <div class="info">
                <strong>Location:</strong>
                ${user.location || "Not available"}
            </div>

            <p>
                <strong>GitHub:</strong>
                <a href="${user.html_url}" target="_blank">
                    View Profile
                </a>
            </p>

        `;

    } catch (error) {

        result.innerHTML =
            `<p class="error">
                Error: ${error.message}
            </p>`;
    }
}

</script>

</body>
</html>
